// --- EEPROM para Credenciales WiFi ---
struct WifiCredentials {
    char ssid1[32];
    char password1[64];
    char ssid2[32];
    char password2[64];
    bool configured; // Para saber si ya se han guardado credenciales
};
WifiCredentials wifiCreds;

#define EEPROM_SIZE sizeof(WifiCredentials)
#define EEPROM_CREDENTIALS_ADDR 0

/**
 * @brief Guarda las credenciales WiFi en la EEPROM.
 */
void saveCredentials() {
    EEPROM.put(EEPROM_CREDENTIALS_ADDR, wifiCreds);
    EEPROM.commit();
    Serial.println("Credenciales guardadas en EEPROM.");
}

/**
 * @brief Carga las credenciales WiFi desde la EEPROM.
 */
void loadCredentials() {
    EEPROM.get(EEPROM_CREDENTIALS_ADDR, wifiCreds);
    if (!wifiCreds.configured) {
        Serial.println("No se encontraron credenciales WiFi guardadas.");
        // Limpiar para asegurar un inicio limpio si los datos están corruptos
        memset(&wifiCreds, 0, sizeof(WifiCredentials));
        wifiCreds.configured = false;
    } else {
        Serial.println("Credenciales WiFi cargadas.");
        Serial.print("SSID1: "); Serial.println(wifiCreds.ssid1);
    }
}

